{
  "name": "apnaride",
  "version": "1.0.0",
  "private": true,
  "description": "ApnaRide: ride-hailing app (MERN + Socket.IO)",
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch backend/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/server.js",
    "lint": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
