# Environment configuration for ApnaRide (API + website)
# Copy this file to .env and fill in your values.

# Port for local development (defaults to 4000)
PORT=4000

# MongoDB connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://bhavesh:Bhavesh%401007@cluster0.bmgjs3d.mongodb.net/ApnaRide?appName=Cluster0

# JWT Secret for signing tokens. Generate using:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=Thisisadifferentsecret

# Optional: Password-reset emails (in dev mode without SMTP, the OTP is printed to the server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
