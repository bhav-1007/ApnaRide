# ApnaRide Environment Variables

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ApnaRide?retryWrites=true&w=majority

# JWT secret key for signing auth tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Port (Render automatically sets this; defaults to 4000 locally)
PORT=4000

# Node Environment ('production' on Render)
NODE_ENV=production

# App timezone (defaults to Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Optional: SMTP email configuration for password-reset OTP emails
# If left blank, OTPs will log to server console for convenience
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
